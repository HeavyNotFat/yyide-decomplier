<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="false">
        <shape android:shape="rectangle" android:useLevel="false">
            <solid android:color="@color/colorCloud" />
            <corners android:radius="8.0dp" />
            <padding android:left="5.0dp" android:top="3.0dp" android:right="5.0dp" android:bottom="3.0dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle" android:useLevel="false">
            <solid android:color="@color/colorCloud" />
            <corners android:radius="8.0dp" />
            <padding android:left="5.0dp" android:top="3.0dp" android:right="5.0dp" android:bottom="3.0dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle" android:useLevel="false">
            <solid android:color="#999999" />
            <corners android:radius="8.0dp" />
            <padding android:left="5.0dp" android:top="3.0dp" android:right="5.0dp" android:bottom="3.0dp" />
        </shape>
    </item>
</selector>
