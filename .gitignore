# ---------------------------------------------------------------------------
# Gradle / Android Studio
# ---------------------------------------------------------------------------
.gradle/
build/
captures/
.externalNativeBuild/
.cxx/
local.properties
.idea/*
!.idea/.gitignore
!.idea/gradle.xml
!.idea/misc.xml
!.idea/compiler.xml
!.idea/encodings.xml
scripts/.idea
*.iml
*.iws
*.ipr
out/
PERMISSION.md

# ---------------------------------------------------------------------------
# Build / reconstruction output
# ---------------------------------------------------------------------------
*.apk
*.aab
*.ap_
*.idsig
*.dex
dist/
logs/
*.log
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# Compiled jars embed original production code/keys; keep them local.
# Only the R constant jar is safe to publish.
# ---------------------------------------------------------------------------
libs/*.jar
!libs/app-r.jar

# ---------------------------------------------------------------------------
# Cloud controller runtime data (regenerated on first start)
# ---------------------------------------------------------------------------
cloud-server/data/site.json
cloud-server/data/layout.json
cloud-server/data/content.json
cloud-server/data/overrides.json
cloud-server/data/requests.log
cloud-server/assets/

# ---------------------------------------------------------------------------
# Secrets / local-only material
# ---------------------------------------------------------------------------
_private/
.secrets.local.json
src/main/res/raw/server.key
src/main/assets/*.cert
*.jks
*.keystore

# Endpoint output that can contain real tokens/responses
scripts/endpoints/output/*.resolved.*
scripts/endpoints/output/groups-resolved/
scripts/endpoints/output/forged-requests.json
scripts/endpoints/output/run-*.jsonl

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------
.DS_Storepython scripts/secrets.py check
         python scripts/secrets.py scrub
Thumbs.db
